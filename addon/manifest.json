{
  "id": "pt.filipe.nuvio.tvhub",
  "version": "3.0.0",
  "name": "PT•TV HUB",
  "description": "PT•TV HUB — IPTV, Filmes e Séries. Um hub português de entretenimento para Nuvio e Stremio.",
  "logo": "https://pt-tv-filme-e-series.onrender.com/assets/logo.svg",
  "background": "https://pt-tv-filme-e-series.onrender.com/assets/background.svg",

  "resources": [
    "catalog",
    "meta",
    "stream"
  ],

  "types": [
    "channel",
    "movie",
    "series"
  ],

  "catalogs": [
    {
      "type": "channel",
      "id": "iptv",
      "name": "📺 IPTV",
      "extra": [
        {
          "name": "search",
          "isRequired": false
        }
      ]
    },
    {
      "type": "movie",
      "id": "pt-movies",
      "name": "🎬 Filmes",
      "extra": [
        {
          "name": "search",
          "isRequired": false
        }
      ]
    },
    {
      "type": "series",
      "id": "pt-series",
      "name": "📺 Séries",
      "extra": [
        {
          "name": "search",
          "isRequired": false
        }
      ]
    }
  ],

  "idPrefixes": [
    "m3u:",
    "xtream:",
    "tmdb:"
  ],

  "behaviorHints": {
    "configurable": true,
    "configurationRequired": false,
    "p2p": false
  }
}
