{
  "id": "pt.filipe.nuvio.tvhub",
  "version": "1.1.0",
  "name": "PT TV Hub",
  "description": "Hub de TV Portugal, IPTV M3U/Xtream Codes e fontes autorizadas.",
  "logo": "https://www.stremio.com/website/stremio-logo-small.png",

  "resources": [
    "catalog",
    "meta",
    "stream",
    "addon_catalog"
  ],

  "types": [
    "channel",
    "tv"
  ],

  "catalogs": [
    {
      "type": "channel",
      "id": "pt-services",
      "name": "TV Portugal"
    },
    {
      "type": "channel",
      "id": "m3u",
      "name": "Minha IPTV"
    }
  ],

  "addonCatalogs": [
    {
      "type": "addon",
      "id": "recommended",
      "name": "Add-ons recomendados"
    }
  ],

  "idPrefixes": [
    "pttv:",
    "m3u:",
    "xtream:"
  ],

  "behaviorHints": {
    "configurable": true,
    "configurationRequired": false,
    "p2p": false
  },

  "config": [
    {
      "key": "iptv_name",
      "type": "text",
      "title": "Nome da IPTV",
      "default": "Minha IPTV"
    },
    {
      "key": "iptv_type",
      "type": "select",
      "title": "Tipo de IPTV",
      "options": [
        "Nenhuma",
        "M3U URL",
        "Xtream Codes"
      ],
      "default": "Nenhuma"
    },
    {
      "key": "m3u_url",
      "type": "text",
      "title": "URL da lista M3U",
      "default": ""
    },
    {
      "key": "xtream_url",
      "type": "text",
      "title": "Xtream Server URL",
      "default": ""
    },
    {
      "key": "xtream_username",
      "type": "text",
      "title": "Xtream Username",
      "default": ""
    },
    {
      "key": "xtream_password",
      "type": "password",
      "title": "Xtream Password",
      "default": ""
    },
    {
      "key": "epg_url",
      "type": "text",
      "title": "EPG URL (opcional)",
      "default": ""
    }
  ]
}
